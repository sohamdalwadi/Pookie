<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnLeaveArena"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_rounded_card"
            android:padding="10dp"
            android:src="@drawable/ic_leave" />

        <!-- Room Code Display with Copy & QR buttons -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/bg_rounded_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/textArenaRoomCode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <ImageView
                android:id="@+id/btnCopyArenaCode"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:src="@drawable/ic_copy" />

            <ImageView
                android:id="@+id/btnShowArenaQr"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:padding="6dp"
                android:src="@drawable/ic_qr_code" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnArenaRematch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_rounded_card"
            android:padding="10dp"
            android:src="@drawable/ic_rematch" />
    </LinearLayout>

    <!-- Solo Bot Debug Controller Chip -->
    <TextView
        android:id="@+id/btnBotModeSelector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_rounded_card"
        android:paddingHorizontal="14dp"
        android:paddingVertical="5dp"
        android:text="Bot: Smart AI"
        android:textColor="@color/mint_accent"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Dual PvP HUD -->
    <com.pookie.game.presentation.ui.views.DualPvpHudView
        android:id="@+id/dualPvpHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

    <!-- Game Board Container -->
    <FrameLayout
        android:id="@+id/gameBoardContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="16dp"
        android:background="@drawable/bg_rounded_card"
        android:layout_gravity="center">

        <com.pookie.game.presentation.ui.views.TicTacToeBoardView
            android:id="@+id/ticTacToeView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone" />

        <com.pookie.game.presentation.ui.views.DotsAndBoxesBoardView
            android:id="@+id/dotsAndBoxesView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone" />

        <com.pookie.game.presentation.ui.views.CouplesQuizView
            android:id="@+id/couplesQuizView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.pookie.game.presentation.ui.views.SoulSyncView
            android:id="@+id/soulSyncView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Waiting For Partner Overlay -->
        <LinearLayout
            android:id="@+id/layoutWaitingForPartner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/pink_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Waiting for partner to join..."
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Share this Room Code with your partner"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Room Code Card -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_rounded_input"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/textWaitingRoomCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pink_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnWaitingCopyCode"
                    style="@style/Widget.Pookie.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Copy Code"
                    android:paddingHorizontal="18dp" />

                <Button
                    android:id="@+id/btnWaitingShowQr"
                    style="@style/Widget.Pookie.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:text="Show QR"
                    android:paddingHorizontal="18dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/textWaitingTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Auto-prompt in: 02:00"
                android:textColor="@color/mint_accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPlayWithEva"
                style="@style/Widget.Pookie.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:text="Play with Eva (AI)"
                android:paddingHorizontal="22dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- New Interactive Bottom Bar with Middle Big Round Nudge Button -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_rounded_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <!-- Reaction: Heart -->
        <ImageView
            android:id="@+id/btnReactionHeart"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="8dp"
            android:src="@drawable/ic_reaction_heart" />

        <!-- Reaction: Thumbs Up -->
        <ImageView
            android:id="@+id/btnReactionThumbsUp"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:padding="8dp"
            android:src="@drawable/ic_thumbs_up" />

        <!-- Middle Big Round Nudge Button -->
        <ImageView
            android:id="@+id/btnNudge"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginHorizontal="14dp"
            android:background="@drawable/bg_nudge_circle"
            android:padding="12dp"
            android:src="@drawable/ic_nudge" />

        <!-- Reaction: Thumbs Down -->
        <ImageView
            android:id="@+id/btnReactionThumbsDown"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="8dp"
            android:src="@drawable/ic_thumbs_down" />

        <!-- Reaction: Lightning -->
        <ImageView
            android:id="@+id/btnReactionLightning"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:padding="8dp"
            android:src="@drawable/ic_reaction_lightning" />
    </LinearLayout>
</LinearLayout>
