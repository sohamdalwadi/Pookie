<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_rounded_card"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Player 1 Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp">

                <com.pookie.game.presentation.ui.views.CircularTurnTimerView
                    android:id="@+id/avatar1TimerView"
                    android:layout_width="64dp"
                    android:layout_height="64dp" />

                <ImageView
                    android:id="@+id/avatar1Icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_reaction_bubble"
                    android:padding="10dp"
                    android:src="@drawable/ic_avatar_male" />
            </FrameLayout>

            <!-- Reaction displayed below profile -->
            <ImageView
                android:id="@+id/reaction1BelowIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_reaction_bubble"
                android:padding="6dp"
                android:visibility="invisible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textPlayer1Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textPlayer1Score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/pink_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- VS Divider / Center Status -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VS"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp" />

        <!-- Player 2 Container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textPlayer2Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textPlayer2Score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mint_accent"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp">

                <com.pookie.game.presentation.ui.views.CircularTurnTimerView
                    android:id="@+id/avatar2TimerView"
                    android:layout_width="64dp"
                    android:layout_height="64dp" />

                <ImageView
                    android:id="@+id/avatar2Icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_reaction_bubble"
                    android:padding="10dp"
                    android:src="@drawable/ic_avatar_female" />
            </FrameLayout>

            <!-- Reaction displayed below profile -->
            <ImageView
                android:id="@+id/reaction2BelowIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_reaction_bubble"
                android:padding="6dp"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>

    <!-- Turn Banner -->
    <TextView
        android:id="@+id/textTurnStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/mint_accent"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
