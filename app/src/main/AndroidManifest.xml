<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".PookieApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_reaction_heart"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_reaction_heart"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pookie"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".presentation.ui.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".presentation.ui.BackendSetupActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".presentation.ui.ProfileSetupActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".presentation.ui.LobbyActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".presentation.ui.GameArenaActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>

</manifest>
